{
  "realm": "strata",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "groups": [
    {
      "name": "strata-admins",
      "path": "/strata-admins"
    }
  ],
  "clients": [
    {
      "clientId": "strata-admin",
      "name": "Strata admin console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "strata-demo-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3001/sso-callback"
      ],
      "webOrigins": [
        "http://localhost:3001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "strata-saml",
      "name": "Strata SAML",
      "enabled": true,
      "protocol": "saml",
      "frontchannelLogout": true,
      "attributes": {
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml.assertion.signature": "true",
        "saml.authnstatement": "true",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
        "saml_assertion_consumer_url_post": "http://localhost:3001/saml2/acs"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "attribute.name": "email",
            "attribute.nameformat": "Basic",
            "user.attribute": "email",
            "friendly.name": "email"
          }
        }
      ],
      "redirectUris": [
        "http://localhost:3001/saml2/acs"
      ]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@example.com",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "demo123",
          "temporary": false
        }
      ],
      "groups": [
        "/strata-admins"
      ]
    }
  ]
}
