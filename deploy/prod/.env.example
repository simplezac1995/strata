# Copy to .env and fill every value before running docker compose.
# Never commit the real .env.

# Public hostname served by Caddy (DNS must point at this host) and the ACME account email.
STRATA_DOMAIN=admin.example.com
ACME_EMAIL=ops@example.com

# Image tag built locally by the compose build (use a release tag for reproducibility).
STRATA_VERSION=0.11.3

# PostgreSQL (the only supported database).
STRATA_DB_NAME=strata
STRATA_DB_USER=strata
STRATA_DB_PASSWORD=__replace_with_a_long_random_database_password__

# Framework secrets: generate with `openssl rand -base64 48` (>= 32 characters, unique per environment).
STRATA_JWT_SECRET=__replace_with_a_random_jwt_secret_at_least_32_chars__
STRATA_ADMIN_PASSWORD=__replace_with_a_long_initial_admin_password__

# Exact browser origins allowed to call the API (comma separated, no wildcard).
STRATA_CORS_ALLOWED_ORIGIN_PATTERNS=https://admin.example.com

# Snowflake worker id [0,31]; unique per concurrently running JVM.
STRATA_WORKER_ID=0
