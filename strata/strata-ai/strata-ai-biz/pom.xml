<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.simplezac1995</groupId>
        <artifactId>strata-ai</artifactId>
        <version>0.11.1</version>
    </parent>
    <artifactId>strata-ai-biz</artifactId>
    <name>strata-ai-biz</name>
    <dependencies>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-ai-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-ai-chat-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-ai-knowledge-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-ai-config-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-system-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-common-data</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-plugin-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>critical-package-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>dev.strata.ai.biz.event</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.30</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
