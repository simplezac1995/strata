        <netty.version>4.2.17.Final</netty.version>
        <postgresql.version>42.7.12</postgresql.version>
        <!-- jackson-databind 2.x / 3.x and log4j-api patch releases (CVE-2026-54515, CVE-2026-59889, GHSA-mhm7-754m-9p8w, CVE-2026-49844). -->
