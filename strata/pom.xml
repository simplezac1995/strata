    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <!--
                      IDE metadata for @ConfigurationProperties. Declared once here so every module that has a
                      properties class gets it; before this the metadata only existed where 8 poms happened to
                      depend on the processor directly.
                    -->
                    <path>
                      <groupId>org.springframework.boot</groupId>
                      <artifactId>spring-boot-configuration-processor</artifactId>
                      <version>${spring-boot.version}</version>
                    </path>
                </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <palantirJavaFormat>
                                <version>${palantir-java-format.version}</version>
                            </palantirJavaFormat>
                            <!--
                              SPDX one-liner instead of the full Apache boilerplate:
                              machine readable (REUSE), and it keeps the diff of a
                              license-tag change to a single line per file.
                            -->
                            <licenseHeader>
                                <content>// SPDX-License-Identifier: Apache-2.0</content>
                                <delimiter>package</delimiter>
                            </licenseHeader>
                            <removeUnusedImports/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>**/dto/**</exclude>
                            <exclude>**/entity/**</exclude>
                            <exclude>**/config/**</exclude>
                            <exclude>**/*Application.class</exclude>
                            <exclude>**/module-info.class</exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>verify-format</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!--
                      JaCoCo's prepare-agent sets the ${argLine} property with its
                      javaagent. We append the Mockito agent so both instruments
                      coexist. -Xshare:off prevents class data sharing from hiding
                      classes from the agents.
                    -->
                    <argLine>${argLine} -Xshare:off -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.agent.version}/mockito-core-${mockito.agent.version}.jar</argLine>
                    <environmentVariables>
                        <!--
                          One password for every test JVM: the seed initializer uses it for the demo
                          admin and the tests log in with it. It must satisfy SecurityRuntimeGuard,
                          because the PostgreSQL profile enables production-settings
                          enforcement —a placeholder value here (e.g. one containing "change-me")
                          made every DB-profile smoke test fail before the context even started.
                        -->
                        <STRATA_ADMIN_PASSWORD>StrataCiAdminPassword2026</STRATA_ADMIN_PASSWORD>
                        <STRATA_JWT_SECRET>strata-test-jwt-secret-rotate-never-use-in-production-2026</STRATA_JWT_SECRET>
                        <STRATA_CORS_ALLOWED_ORIGIN_PATTERNS>http://localhost:5173</STRATA_CORS_ALLOWED_ORIGIN_PATTERNS>
                        <STRATA_DB_HOST>127.0.0.1</STRATA_DB_HOST>
                        <STRATA_DB_PORT>5432</STRATA_DB_PORT>
                        <STRATA_DB_NAME>strata</STRATA_DB_NAME>
                        <STRATA_DB_USER>strata</STRATA_DB_USER>
                        <STRATA_DB_PASSWORD>strata</STRATA_DB_PASSWORD>
                        <STRATA_REDIS_HOST>127.0.0.1</STRATA_REDIS_HOST>
                        <STRATA_REDIS_PORT>6379</STRATA_REDIS_PORT>
                        <STRATA_WORKER_ID>1</STRATA_WORKER_ID>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <encoding>UTF-8</encoding>

                </configuration>
            </plugin>
        </plugins>
    </build>
    <distributionManagement>
        <!-- Central Portal: publishing is handled by central-publishing-maven-plugin in the release profile. -->
        <repository>
            <id>central</id>
            <url>https://central.sonatype.com/api/v1/publisher/deploy</url>
        </repository>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/api/v1/publisher/deploy</url>
        </snapshotRepository>
    </distributionManagement>

    <profiles>
        <!--
          Release-only tooling. Kept in a profile on purpose: enforcer/SBOM/sources/javadoc/GPG/Central plugins are
          network-only, and a plain mvn verify (including this repo's offline dev loop and CI) must stay fast.
          Release:  mvn -Prelease deploy   (see .github/workflows/release.yml)
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.6.2</version>
                        <executions>
                            <execution>
                                <id>enforce-release-toolchain</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireJavaVersion>
                                            <version>[25,26)</version>
                                        </requireJavaVersion>
                                        <requireMavenVersion>
                                            <version>[3.9.0,)</version>
                                        </requireMavenVersion>
                                        <banDuplicatePomDependencyVersions/>
                                        <requireSameVersions/>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>2.9.1</version>
                        <executions>
                            <execution>
                                <id>sbom</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>makeAggregateBom</goal>
                                </goals>
                                <configuration>
                                    <outputFormat>json</outputFormat>
                                    <outputName>bom</outputName>
                                    <includeTestScope>false</includeTestScope>
                                    <!-- the aggregator root is not a deployable module; generate the BOM anyway -->
                                    <skipNotDeployed>false</skipNotDeployed>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
