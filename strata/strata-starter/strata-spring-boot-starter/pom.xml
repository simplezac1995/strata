<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.simplezac1995</groupId>
        <artifactId>strata-starter</artifactId>
        <version>0.6.0</version>
    </parent>
    <artifactId>strata-spring-boot-starter</artifactId>
    <packaging>jar</packaging>
    <name>strata-spring-boot-starter</name>
    <description>
        Core Strata starter: common kernel + system domain + plugin SPI + Flyway migrations, with the
        Spring Boot starters and JDBC drivers a standalone deployment needs. Aggregation only — every
        module ships its own AutoConfiguration.imports. Plugins (storage, Stripe, LLM, Excel, AES,
        Flowable) stay opt-in and are deliberately not included (ADR-0025).
    </description>

    <dependencies>
        <!-- Platform modules -->
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-common-data</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-system-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-system-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-system-rbac-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-system-ops-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-system-config-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-system-communication-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.simplezac1995</groupId>
            <artifactId>strata-plugin-api</artifactId>
        </dependency>

        <!-- Framework starters the platform compiles against -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- PostgreSQL is the only supported runtime database. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
