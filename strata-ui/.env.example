# Copy to .env.local and adjust as needed.

# Default UI language: "zh" (Chinese) or "en" (English).
# User choice is persisted in localStorage and wins over this default.
VITE_DEFAULT_LANG=zh

# Backend base URL. Leave empty when using the Vite dev proxy (/api -> http://localhost:8080).
VITE_API_BASE_URL=

# Optional AES-GCM payload encryption (requires STRATA_ENCRYPT_AES_ENABLED=true on API).
# Key must match server strata.plugin.encrypt.aes.key (base64 32-byte).
VITE_API_ENCRYPT=false
VITE_API_ENCRYPT_KEY=
