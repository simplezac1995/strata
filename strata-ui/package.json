{
  "name": "strata-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "browserslist": [
    "Chrome >= 90",
    "Edge >= 90",
    "Firefox >= 90",
    "Safari >= 14"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "analyze": "ANALYZE=true pnpm build",
    "lint": "oxlint src",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check": "node scripts/check.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "i18n:verify": "node scripts/verify-i18n.mjs",
    "i18n:scan": "node scripts/scan-hardcoded-ui.mjs",
    "i18n:patch": "node scripts/patch-zh-overrides.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "generate:api-types": "openapi-typescript -c openapi-typescript.config.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@sentry/react": "^10.74.0",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.32.2",
    "axios": "^1.20.0",
    "bpmn-js": "^18.25.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "web-vitals": "^6.2.1"
  }
}
